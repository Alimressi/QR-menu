generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Restaurant {
  id       Int     @id @default(autoincrement())
  name     String
  slug     String  @unique
  logoUrl  String?
  settings String? // JSON string for theme settings

  /// Subscription state: "trial" | "active" | "past_due" | "disabled".
  /// Only trial and active are served to guests; the other two show a notice
  /// instead of the menu while every dish, photo and setting stays intact.
  /// Existing restaurants default to active so nothing changes for them.
  status      String    @default("active")
  /// When a trial stops counting as served. Ignored unless status is "trial".
  trialEndsAt DateTime?

  /// Lemon Squeezy subscription this tenant is billed through, when it has one.
  /// The checkout carries restaurant_id as custom data so the first webhook can
  /// find the tenant; this is how every webhook after it finds them again.
  lemonSqueezySubscriptionId String? @unique
  lemonSqueezyCustomerId     String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  categories  Category[]
  dishes      Dish[]
  orders      Order[]
  waiterCalls WaiterCall[]
  menuOpens   MenuOpenStat[]
  dishViews   DishViewStat[]
}

model Category {
  id           Int        @id @default(autoincrement())
  nameEn       String
  nameRu       String
  nameAz       String
  /// Where the category sits in the menu. Backfilled from id, so an untouched
  /// menu keeps the order it was created in; moving one is a single write.
  sortOrder    Int        @default(0)
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes       Dish[]

  @@index([restaurantId])
}

model Dish {
  id             Int    @id @default(autoincrement())
  nameEn         String
  nameRu         String
  nameAz         String
  descriptionEn  String
  descriptionRu  String
  descriptionAz  String
  price          Float
  imageUrl       String
  imagePositionX Float  @default(50)
  imagePositionY Float  @default(50)

  /// Today's stop list: the kitchen has run out. The dish stays in the menu,
  /// shown but not orderable, and comes back with one click. Defaults to false
  /// so a bad write can never hide a dish that is actually available.
  soldOut      Boolean        @default(false)
  categoryId   Int
  restaurantId Int
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  orderItems   OrderItem[]
  options      DishOption[]
  views        DishViewStat[]

  @@index([restaurantId])
  @@index([categoryId])
}

model DishOption {
  id        Int         @id @default(autoincrement())
  dishId    Int
  nameEn    String
  nameRu    String
  nameAz    String
  price     Float // Доплата за опцию (может быть 0)
  dish      Dish        @relation(fields: [dishId], references: [id], onDelete: Cascade)
  OrderItem OrderItem[]
}

model Order {
  id                Int         @id @default(autoincrement())
  tableNumber       String
  status            String      @default("new")
  total             Float
  restaurantId      Int
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  checkoutSessionId String?
  paymentIntentId   String?
  restaurant        Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items             OrderItem[]

  @@index([restaurantId])
}

model OrderItem {
  id           Int         @id @default(autoincrement())
  /// When this line appeared. A line created after its order was placed is a
  /// second round — the panel marks it so the kitchen can see what is new.
  createdAt    DateTime    @default(now())
  /// Bumped when the quantity changes, which is the other way a guest adds.
  updatedAt    DateTime    @default(now())
  orderId      Int
  dishId       Int
  optionId     Int? // выбранная опция (если есть)
  quantity     Int
  price        Float
  nameEn       String
  nameRu       String
  nameAz       String
  optionNameEn String?
  optionNameRu String?
  optionNameAz String?
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish         Dish        @relation(fields: [dishId], references: [id], onDelete: Restrict)
  option       DishOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
}

model WaiterCall {
  id           Int        @id @default(autoincrement())
  tableNumber  String
  status       String     @default("active")
  restaurantId Int
  createdAt    DateTime   @default(now())
  resolvedAt   DateTime?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

/// How many times a menu was opened, one row per restaurant per day.
///
/// Counted rather than logged. A row per visit would be the flexible thing and
/// the wrong one here: the question anybody asks is "how many this week", the
/// answer is a sum, and a year of raw visits costs storage to answer it more
/// slowly. A daily bucket keeps the whole history of every restaurant smaller
/// than one dish photograph.
///
/// `day` is a plain "YYYY-MM-DD" in UTC, not a timestamp — the unit is the day,
/// and storing it as text makes the upsert key exact instead of nearly-equal.
model MenuOpenStat {
  restaurantId Int
  day          String
  count        Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([restaurantId, day])
  @@index([restaurantId, day])
}

/// The same, for taps on a single dish — what the guest opened to look at.
model DishViewStat {
  restaurantId Int
  dishId       Int
  day          String
  count        Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@id([restaurantId, dishId, day])
  @@index([restaurantId, day])
}
