{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "qr-menu-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-18",
  "compatibility_flags": ["nodejs_compat"],

  // Deliberately a SEPARATE worker from the app it watches. A monitor that runs
  // inside the thing it monitors goes quiet exactly when it is needed most —
  // when the app is the part that is broken.
  // Every half hour, not every ten minutes. The database is what this costs:
  // Neon suspends a compute after five idle minutes, so a probe every ten kept
  // it awake roughly half the day — 3.6 of the free plan's 100 CU-hours a day,
  // which projected to 108 a month for a service whose guests number in the
  // hundreds. At thirty the compute sleeps most of the hour and the same work
  // costs about a third as much.
  //
  // What it buys back: an outage is noticed in fifteen minutes on average
  // rather than five. For a menu that is a fair trade — nothing here pages
  // anyone at night, and the alert exists so the client is not the one who
  // notices first.
  "triggers": {
    "crons": ["*/30 * * * *"]
  },

  "vars": {
    // The address a guest actually uses. It was the workers.dev one until the
    // custom domain took over and that route started answering 404 — which the
    // monitor read as "the public channel is unavailable" and quietly stopped
    // alerting on, for every restaurant, for as long as it was wrong. A checker
    // pointed at an address nobody visits is worse than no checker: it reports
    // success while the thing it guards is unwatched.
    "SITE_URL": "https://qr-menu.az",
    // Read from the console URL. Not a secret; the API key that goes with it is
    // one, and lives in `wrangler secret put NEON_API_KEY`.
    "NEON_PROJECT_ID": "orange-flower-46662484"
  },

  // Cloudflare refuses a plain fetch() from one Worker to another on the same
  // workers.dev subdomain — it answers with error 1042 rather than reaching the
  // app. A service binding is the supported path.
  //
  // Trade-off worth knowing: this calls the app Worker directly, so it verifies
  // the app's code and its database, but not DNS, TLS or the public edge in
  // front of them. It catches the class of failure actually seen in production
  // (the app itself erroring); a total DNS outage would need an outside checker.
  "services": [
    {
      "binding": "APP",
      "service": "qr-menu"
    }
  ],

  // The monitor refreshes the last-known-good copy of every menu here, so the app
  // can still serve one when the database is down. Deliberately the monitor's job
  // and not the app's: writing these from the guest page put an 85 KB menu in the
  // app isolate's memory per render and got the Worker killed for exceeding
  // resources. Same bucket the dish photos live in, under snapshots/menu/.
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "qr-menu-media"
    }
  ],

  // Remembers whether each menu was up on the previous run, so a menu that stays
  // down produces one message rather than one every ten minutes.
  "kv_namespaces": [
    {
      "binding": "MONITOR_STATE",
      "id": "69fc6da1ff0345438a4199fb5ef26263"
    }
  ],

  "observability": {
    "enabled": true
  }
}
