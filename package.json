{
  "name": "qr_menu_restoran",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "check:auth": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/check-auth.ts",
    "check:media": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/check-media.ts",
    "check:subscription": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/check-subscription.ts",
    "check:menu-import": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/check-menu-import.ts",
    "backup": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/backup.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "prisma db seed",
    "ninelives:import": "node node_modules/tsx/dist/cli.mjs scripts/import-ninelives-full-menu.ts",
    "ninelives:az:normalize": "node node_modules/tsx/dist/cli.mjs scripts/normalize-ninelives-az.ts",
    "frank:setup": "node node_modules/tsx/dist/cli.mjs scripts/setup-frank.ts",
    "frank:theme:apply": "node node_modules/tsx/dist/cli.mjs scripts/apply-frank-theme.ts",
    "frank:theme:verify": "node node_modules/tsx/dist/cli.mjs scripts/verify-frank-theme.ts",
    "check:orders": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/check-orders-query.ts",
    "check:qr": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/check-qr-token.ts",
    "check:menu": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/check-menu-query.ts",
    "check:snapshot": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/check-snapshot.ts",
    "check": "node scripts/check-all.mjs"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^6.16.2",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "prisma": "^6.16.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.2",
    "typescript": "^5",
    "wrangler": "^4.92.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts && tsx scripts/setup-frank.ts"
  }
}
