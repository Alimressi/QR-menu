{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qr-menu",
  "main": ".open-next/worker.js",
  "keep_vars": true,
  "compatibility_date": "2026-04-18",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NEXT_PUBLIC_BASE_URL": "https://qr-menu.imran-ask-2006.workers.dev"
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Dish photos uploaded from the admin panel. Workers have no writable disk, so
  // uploads go here instead of public/uploads and are served via /api/media/*.
  //
  // NOTE: `wrangler deploy` fails while this bucket does not exist. Enable R2 in
  // the Cloudflare dashboard once, then: npx wrangler r2 bucket create qr-menu-media
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "qr-menu-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
