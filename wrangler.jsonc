{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qr-menu",
  "main": ".open-next/worker.js",
  "keep_vars": true,
  "compatibility_date": "2026-04-18",
  "compatibility_flags": ["nodejs_compat"],
  // Both hostnames are served by this one Worker. `custom_domain` lets Wrangler
  // create and own the DNS records for them, which is why the zone was left
  // empty when it was added — a hand-written A record here would only have to
  // be deleted again.
  //
  // The workers.dev address keeps working alongside these, so nothing that
  // already points at it breaks.
  "routes": [
    { "pattern": "qr-menu.az", "custom_domain": true },
    { "pattern": "www.qr-menu.az", "custom_domain": true }
  ],

  "vars": {
    "NEXT_PUBLIC_BASE_URL": "https://qr-menu.az"
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Dish photos uploaded from the admin panel. Workers have no writable disk, so
  // uploads go here instead of public/uploads and are served via /api/media/*.
  //
  // NOTE: `wrangler deploy` fails while this bucket does not exist. Enable R2 in
  // the Cloudflare dashboard once, then: npx wrangler r2 bucket create qr-menu-media
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "qr-menu-media"
    },
    // Where a rendered menu page is kept between guests. The name is fixed by
    // OpenNext, which looks this binding up by exactly this string.
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "qr-menu-media"
    }
  ],
  "observability": {
    "enabled": true
  }
}
